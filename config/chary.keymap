#define ZMK_POINTING_DEFAULT_SCRL_VAL 2

#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define NUMBER  1
#define FN  2
#define HOTKEY  3

/ {
    combos {
        compatible = "zmk,combos";

        b {
            bindings = <&kp B>;
            key-positions = <25 26>;
        };

        snipe {
            bindings = <&mo 5>;
            key-positions = <26 27>;
        };

        scroll {
            bindings = <&mo 4>;
            key-positions = <21 22>;
        };

        mouse2 {
            bindings = <&mo 3>;
            key-positions = <31 32>;
        };

        scroll2 {
            bindings = <&mo 4>;
            key-positions = <27 28>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&kp Q  &kp W  &kp E  &kp R             &kp T                  &kp Y  &kp U      &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F             &kp G                  &kp H  &kp J      &kp K      &kp L    &kp SEMI
&kp Z  &kp X  &kp C  &kp V             &mo 2                  &kp N  &kp M      &kp COMMA  &kp DOT  &lt 3 FSLH
                     &kp LEFT_CONTROL  &kp LEFT_SHIFT  &mo 1  &mo 2  &kp SPACE
            >;
        };

        number_layer {
            label = "NUMBER";
            bindings = <
&kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                   &kp NUMBER_6   &kp N7        &kp N8        &kp N9        &kp N0
&kp LEFT_SHIFT  &kp DEL       &kp UP_ARROW  &kp C_VOL_DN  &kp C_VOLUME_UP          &none          &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS
&kp LCTRL       &kp LEFT      &kp DOWN      &kp RIGHT     &kp C_PLAY_PAUSE         &none          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD
                                            &kp TAB       &kp LEFT_ALT      &none  &kp BACKSPACE  &kp N0
            >;
        };

        fn_layer {
            label = "FN";
            bindings = <
&kp ESCAPE          &kp F10  &kp F11  &kp F12  &kp TILDE                     &bt BT_SEL 0    &bt BT_SEL 1   &bt BT_SEL 2      &bt BT_CLR         &kp BACKSPACE
&kp LS(LC(ESCAPE))  &kp F7   &kp F8   &kp F9   &kp NON_US_BACKSLASH          &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SQT
&kp LG(LS(S))       &kp F4   &kp F5   &kp F6   &kp PIPE                      &kp UNDERSCORE  &kp PLUS       &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp ENTER
                                      &kp F1   &kp F2                &kp F3  &none           &kp RIGHT_ALT
            >;
        };

        mouse_layer {
            label = "mouse";
            bindings = <
&trans            &trans    &trans    &trans    &trans          &trans  &trans     &trans     &trans     &trans
&kp LEFT_SHIFT    &mkp MB4  &trans    &mkp MB5  &trans          &trans  &mkp MB4   &trans     &mkp MB5   &trans
&kp LEFT_CONTROL  &mkp MB1  &mkp MB3  &mkp MB2  &trans          &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &kp LS(ENTER)
                                      &trans    &trans  &trans  &trans  &kp N0
            >;
        };

        scroll_layer {
            label = "scroll";
            bindings = <
&trans  &trans    &trans    &trans    &trans          &trans  &trans    &trans  &trans  &trans
&trans  &mkp MB4  &trans    &mkp MB5  &trans          &trans  &mkp MB4  &trans  &trans  &trans
&trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans          &trans  &trans    &trans  &trans  &trans
                            &trans    &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            label = "snipe";
            bindings = <
&trans  &trans    &trans    &trans    &trans          &trans  &trans  &trans  &trans  &trans
&trans  &mkp MB4  &trans    &mkp MB5  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans          &trans  &trans  &trans  &trans  &trans
                            &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
